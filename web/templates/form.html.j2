{%- extends 'base.html.j2' %}
{% block body %}
  <form action='' method='POST'>
    {%- for entry in form %}
    <label for='{{ entry.id }}'>{{ entry.title }}</label>
    <input type='{{ entry.type }}' id='{{ entry.id }}' name='{{ entry.id }}' placeholder='{{ entry.placeholder }}'>
    <br>
    {%- endfor %}
    <button type='submit'> Submit </button>
  </form>
{% endblock %}
